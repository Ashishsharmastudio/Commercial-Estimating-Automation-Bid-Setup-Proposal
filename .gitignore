# ==========================================
# Atlantic Estimating OS - Master .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env*.local
!.env.example
backend/.env
frontend/.env

# Node & Frontend dependencies
node_modules/
**/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js & Turbopack build outputs
.next/
**/.next/
frontend/.next/
out/
build/
dist/
.turbo/

# Python Virtual Environments & Bytecode
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.mypy_cache/
.ruff_cache/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary files
logs/
*.log
tmp/
temp/
