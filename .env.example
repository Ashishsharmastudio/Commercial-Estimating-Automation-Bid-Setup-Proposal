# ==============================================================================
# ATLANTIC ESTIMATING OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and supply your credentials
# ==============================================================================

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
DATABASE_NAME=atlantic_estimating_os

# JWT Secret for Session & RBAC Auth
JWT_SECRET=super-secret-atlantic-estimating-key-2026

# ==============================================================================
# AI REASONING ENGINE (FOR SPEC QUALIFICATION & PLAIN-ENGLISH SUMMARIES)
# Selected AI Provider & Model Name (Switch anytime based on preference)
# Supported Gemini models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# Supported OpenAI models: gpt-4o, gpt-4o-mini
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash

# Option 1: Google Gemini (Recommended - 1M token context for 50-100 page spec books)
# Where to get it:
# 1. Go to Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Paste the key below:
GEMINI_API_KEY=your-gemini-api-key

# Option 2: OpenAI GPT-4o / GPT-4o-mini (Alternative)
# Where to get it:
# 1. Go to OpenAI Platform: https://platform.openai.com/api-keys
# 2. Click "Create new secret key"
# 3. Paste the key below:
OPENAI_API_KEY=

# ==============================================================================
# PHASE 1 EMAIL INGESTION: KARLA'S DEDICATED OUTLOOK FOLDER
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: MICROSOFT GRAPH API (Office 365 OAuth2 Client Credentials) [RECOMMENDED]
# ------------------------------------------------------------------------------
# How and where to get these secrets:
# 1. Go to Microsoft Azure Portal: https://portal.azure.com
# 2. In search bar, type "Microsoft Entra ID" (formerly Azure Active Directory).
# 3. In the left navigation, click "App registrations" -> "+ New registration".
#    - Name: "Atlantic Estimating OS"
#    - Supported account types: "Accounts in this organizational directory only" (Single tenant)
#    - Redirect URI: Leave blank (not needed for client credentials daemon)
#    - Click "Register".
# 4. On the Overview page:
#    - Copy "Directory (tenant) ID" -> paste as AZURE_TENANT_ID
#    - Copy "Application (client) ID" -> paste as AZURE_CLIENT_ID
# 5. In the left navigation, click "Certificates & secrets" -> "+ New client secret":
#    - Description: "Estimating OS Mailbox Reader"
#    - Expires: Recommended 12 to 24 months
#    - Click "Add"
#    - IMPORTANT: Immediately copy the "Value" (NOT Secret ID) -> paste as AZURE_CLIENT_SECRET
# 6. In the left navigation, click "API permissions" -> "+ Add a permission":
#    - Select "Microsoft Graph" -> choose "Application permissions"
#    - Search for and check "Mail.Read" (or "Mail.ReadBasic.All")
#    - Click "Add permissions"
#    - Click "Grant admin consent for <Your Organization>" and verify green checkmark appears.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OUTLOOK_MONITORED_EMAIL=karla@atlanticflooring.com
OUTLOOK_FOLDER_NAME=Inbox/Bid Invites

# ------------------------------------------------------------------------------
# OPTION B: IMAP4 OVER SSL (Universal Direct Mailbox Fallback)
# ------------------------------------------------------------------------------
# Use this if you do not have Azure Tenant Administrator access:
# 1. For Microsoft 365 accounts with Multi-Factor Authentication:
#    - Go to https://mysignins.microsoft.com/security-info
#    - Click "+ Add sign-in method" -> choose "App password"
#    - Name it "Atlantic Estimating OS" -> Copy the 16-character generated password.
# 2. Ensure IMAP protocol is enabled for Karla's mailbox in Microsoft 365 Admin Center:
#    - Users -> Active users -> Karla Delaet -> Mail tab -> Manage email apps -> IMAP checked.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=karla@atlanticflooring.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX/Bid Invites

# ==============================================================================
# QUICKBOOKS ONLINE (PHASE 4 SOV SYNC)
# ==============================================================================
QBO_ENVIRONMENT=sandbox
QBO_REALM_ID=1234567890

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api